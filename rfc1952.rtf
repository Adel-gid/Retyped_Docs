\clbrdrl\brdrw1\brdrs\clbrdrt\brdrw1\brdrs\clbrdrr\brdrw1\brdrs\clbrdrb\brdrw1\brdrs \cellx5907 
\pard\intbl\f1 ...file comment, zero-terminated... (more-->)\cell\row 
