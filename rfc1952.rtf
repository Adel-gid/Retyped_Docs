\trowd\trgaph72\trleft568\trpaddl72\trpaddr72\trpaddfl3\trpaddfr3
\clbrdrl\brdrw1\brdrs\clbrdrt\brdrw1\brdrs\clbrdrr\brdrw1\brdrs\clbrdrb\brdrw1\brdrs \cellx9703 
\pard\intbl\f1 /* Table of CRCs of all 8-bit messages. */\par
unsigned long crc_table[256];\par
\par
/* Flag: has the table been computed? Initially false. */\par
int crc_table_computed = 0;\par
\par
/* Make the table for a fast CRC. */\par
void make_crc_table(void) \{\par
  unsigned long c;\par
  int n, k;\par
  for (n = 0; n < 256; n++) \{\par
    c = (unsigned long)n;\par
    for (k = 0; k < 8; k++) \{\par
      if (c & 1) \{\par
        c = 0xedb88320L ^ (c >> 1);\par
      \} else \{\par
        c = c >> 1;\par
      \}\par
    \}\par
    crc_table[n] = c;\par
  \}\par
  crc_table_computed = 1;\par
\}\par
\par
/*\par
  Update a running crc with the bytes buf[0..len-1] and return the updated crc. The crc should be initialized to zero. Pre- and post-conditioning (one's complement) is performed within this function so it shouldn't be done by the caller. Usage example :\par
  unsigned long crc = 0L;\par
  while (read_buffer(buffer, length) != EOF) \{\par
    crc = update_crc(crc, buffer, length);\par
  \}\par
  if (crc != original_crc) error();\par
*/\par
unsigned long update_crc(unsigned long crc, unsigned char *buf, int len) \{\par
  unsigned long c = crc ^ 0xffffffffL;\par
  int n;\par
  if (!crc_table_computed)\par
    make_crc_table();\par
  for (n = 0; n < len; n++) \{\par
    c = crc_table[(c ^ buf[n]) & 0xff] ^ (c >> 8);\par
  \}\par
  return c ^ 0xffffffffL;\par
\}\par
\par
/* Return the CRC of the bytes buf[0..len-1]. */\par
unsigned long crc(unsigned char *buf, int len) \{\par
  return update_crc(0L, buf, len);\par
\}\f0\cell\row 
\pard\li284\sl240\slmult1\tx1136\par
