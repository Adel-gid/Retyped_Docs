\pard\intbl\f2 #define BASE 65521 /* largest prime smaller that 65536 */\par
\par
/*\par
  Update a running Adler-32 checksum with the bytes buf[0..len-1] and return the updated checksum. The Adler-32 checksum should be initialized to 1.\par
\par
Usage example :\par
  unsigned long adler = 1L;\par
  while (read_buffer(buffer, length) != EOF) \{\par
    adler = update_adler32(adler, buffer, length);\par
  \}\par
  if (adler != original_adler) error();\par
*/\par
\par
unsigned long update_adler32(unsigned long adler, unsigned char *buf, int len) \{\par
  unsigned long s1 = adler & 0xFFFF;\par
  unsigned long s2 = (adler >> 16) & 0xFFFF;\par
  int n;\par
  for (n = 0; n < len; n++) \{\par
    s1 = (s1 + buf[n]) % BASE;\par
    s2 = (s2 + s1) % BASE;\par
  \}\par
  return (s2 << 16) + s1;\par
\}\par
\par
/* Return the adler32 of the bytes buf[0..len-1] */\par
\par
unsigned long adler32(unsigned char *buf, int len) \{\par
  return update_adler32(1L, buf, len);\par
\}\f0\cell\row 
